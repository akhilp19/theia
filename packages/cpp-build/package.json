{
  "name": "@theia/cpp-build",
  "version": "1.73.0",
  "description": "Theia - C/C++ Build extension. Detects build systems, drives compiler-driven indexing, and manages cross-platform C/C++ builds.",
  "dependencies": {
    "@theia/core": "1.73.0",
    "@theia/workspace": "1.73.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "theiaExtensions": [
    {
      "frontend": "lib/browser/cpp-build-frontend-module",
      "backend": "lib/node/cpp-build-backend-module"
    }
  ],
  "keywords": [
    "theia-extension",
    "cpp",
    "cmake",
    "build-system"
  ],
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/akhilp19/theia.git"
  },
  "files": [
    "lib",
    "src"
  ],
  "scripts": {
    "build": "theiaext build",
    "clean": "theiaext clean",
    "compile": "theiaext compile",
    "lint": "theiaext lint",
    "test": "theiaext test",
    "watch": "theiaext watch"
  },
  "devDependencies": {
    "@theia/ext-scripts": "1.73.0"
  },
  "nyc": {
    "extends": "../../configs/nyc.json"
  }
}
